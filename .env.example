# --- model ---
# comma-separated: turbo (English, fastest) and/or multilingual (23 langs incl. Hindi)
TTS_MODELS=turbo,multilingual
TTS_DEVICE=cuda
# set to 0 to skip the Perth watermark pass (saves ~10-30 ms per chunk)
TTS_WATERMARK=1
# output gain per model (multilingual is ~3x louder than turbo out of the box)
TTS_GAIN_TURBO=1.0
TTS_GAIN_MULTILINGUAL=0.4
# HF token if the checkpoint repos are gated for your account
HF_TOKEN=

# --- voices ---
TTS_VOICES_DIR=voices
# voice used when a client asks for an OpenAI voice name (alloy, nova, ...) or none
TTS_DEFAULT_VOICE=default

# --- server ---
TTS_HOST=0.0.0.0
TTS_PORT=8000
# comma-separated bearer keys; leave empty to disable auth (LAN use, TTS_GATEWAY=0 only)
TTS_API_KEYS=

# --- gateway (accounts, API keys, quotas, usage) ---
# 1 = keys live in the SQLite store; create the first account with scripts/admin.py
TTS_GATEWAY=0
TTS_DB_PATH=data/voiceagent.db
# admin key: unlocks /admin/* and the dashboard's admin panel, bypasses quotas
TTS_ADMIN_KEY=
# public base URL shown in the dashboard and docs
TTS_PUBLIC_URL=http://localhost:8000

# --- streaming ---
# words in the first chunk (smaller = faster first audio, slightly choppier)
TTS_FIRST_CHUNK_WORDS=10
TTS_MAX_CHUNK_CHARS=250
# chunks generated ahead of playback per request
TTS_LOOKAHEAD=2

# --- turbo token-level streaming ---
# speech tokens (25 per second) generated before the first vocoder pass
TTS_FIRST_BLOCK_TOKENS=12
# seconds of the reference clip the vocoder conditions on per block (shorter = faster blocks)
TTS_REF_SECONDS=6
# run the T3 decoder in fp16 and replay it as a CUDA graph (~3.5x faster tokens)
TTS_T3_FP16=1
TTS_CUDA_GRAPH=1

# --- talk (live conversation demo: Whisper STT + LLM + TTS) ---
# 0 = don't load Whisper (saves ~1.5 GB VRAM; the Talk page is disabled)
TTS_STT=1
TTS_STT_MODEL=openai/whisper-large-v3-turbo
# any OpenAI-compatible chat endpoint; Ollama locally by default (ollama pull qwen2.5:3b-instruct)
TTS_LLM_BASE_URL=http://127.0.0.1:11434/v1
TTS_LLM_API_KEY=ollama
TTS_LLM_MODEL=qwen2.5:7b-instruct
